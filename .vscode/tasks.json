{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Turbo Track",
      "type": "shell",
      "command": "clang++",
      "args": [
        "src/main.cpp",
        "-o",
        "game",
        "-std=c++17",
        "-I/opt/homebrew/opt/sfml/include",
        "-L/opt/homebrew/opt/sfml/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}